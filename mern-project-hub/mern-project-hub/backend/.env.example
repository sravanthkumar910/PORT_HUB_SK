# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (no trailing slash)
# Dev example:  http://localhost:5173
# Prod example: https://project-hub.vercel.app,https://project-hub-git-main-yourname.vercel.app
CLIENT_URL=http://localhost:5173

# ---- MongoDB Atlas ----
# Atlas -> Connect -> Drivers -> copy string, then replace <password> and add a db name.
# This same URI is used in both development and production - Atlas is already cloud-hosted.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/project-hub?retryWrites=true&w=majority
# mongodb://sravanthkumar910_db_user:Pocetqb5WD8BU21O@ac-z5o3yrn-shard-00-00.dd5q2qs.mongodb.net:27017,ac-z5o3yrn-shard-00-01.dd5q2qs.mongodb.net:27017,ac-z5o3yrn-shard-00-02.dd5q2qs.mongodb.net:27017/?ssl=true&replicaSet=atlas-ww3hhd-shard-0&authSource=admin&appName=Cluster0
# ---- JWT Auth ----
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ---- Google OAuth (Calendar + Drive) ----
# Google Cloud Console -> APIs & Services -> Credentials
# Enable: Google Calendar API, Google Drive API
# Authorized redirect URI must match exactly, per environment:
#   Dev:  http://localhost:5000/api/integrations/google/callback
#   Prod: https://your-backend.onrender.com/api/integrations/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# ---- GitHub ----
# Not required here - users connect their own GitHub token from the app's
# Settings page and it's stored per-user in MongoDB. Nothing to set here.
